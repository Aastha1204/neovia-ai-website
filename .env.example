# Copy to .env.local (local) and add the same values in Vercel > Project > Settings > Environment Variables.

# Supabase (server only: never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your live site URL (used for canonical, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Plausible analytics domain, e.g. your-domain.com. Leave empty to turn analytics off.
NEXT_PUBLIC_ANALYTICS_ID=

# Card / net banking / wallets via Razorpay (razorpay.com > Settings > API Keys). Leave empty to keep the card button off; UPI works without these.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: email receipts via Resend (resend.com). Without these the receipt still shows on the page, and Razorpay can email receipts itself.
# To email customers, verify your domain in Resend and set RECEIPT_FROM, e.g. Neovia AI <receipts@yourdomain.com>
RESEND_API_KEY=
# Where alerts (new meeting, new lead, payments) are emailed. Until you verify a domain in Resend this must be the email your Resend account uses.
OWNER_EMAIL=
RECEIPT_FROM=

# CarePlus bookings -> Google Sheet (see scripts/google-sheet-booking.gs). Leave empty to skip saving.
GOOGLE_SHEET_WEBHOOK=
GOOGLE_SHEET_TOKEN=

# Neo, the website chat assistant. Pick the AI with NEO_PROVIDER=openai (GPT) or anthropic (Claude).
# Without the matching key the chat shows a "WhatsApp us" message.
NEO_PROVIDER=anthropic
OPENAI_API_KEY=
# Optional: GPT model (default gpt-4o-mini)
OPENAI_MODEL=anthropic
ANTHROPIC_API_KEY=
# Optional: cheaper model for Neo, e.g. claude-haiku-5-5 or claude-sonnet-5-5 (default claude-opus-5-5)
NEO_MODEL=
# Optional: WhatsApp alerts to Aastha via the Meta WhatsApp Cloud API. Without these, alerts go by email (RESEND_API_KEY) and are saved in Supabase.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP=
