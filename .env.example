# Copy to .env.local (local) and add the same values in Vercel > Project > Settings > Environment Variables.

# Supabase (server only: never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live site URL (used for canonical, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Plausible analytics domain, e.g. your-domain.com. Leave empty to turn analytics off.
NEXT_PUBLIC_ANALYTICS_ID=

# Card / net banking / wallets via Razorpay (razorpay.com > Settings > API Keys). Leave empty to keep the card button off; UPI works without these.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: email receipts via Resend (resend.com). Without these the receipt still shows on the page, and Razorpay can email receipts itself.
# To email customers, verify your domain in Resend and set RECEIPT_FROM, e.g. Neovia AI <receipts@yourdomain.com>
RESEND_API_KEY=
RECEIPT_FROM=
